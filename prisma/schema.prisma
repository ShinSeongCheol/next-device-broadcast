generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model device {
  id             Int       @id @default(autoincrement())

  name           String?
  ip             String    @unique
  service        String    @default("ssh")
  port           Int
  username       String?
  password       String?
  healthStatus   String?   @map("health_status")
  lastHealthTime DateTime? @map("last_health_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  audioCards audioCard[]
  @@map("device")
}

model audioCard {
  id Int @id @default(autoincrement())
  deviceId Int
  device device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  cardIndex Int @map("card_index")
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mixerControls mixerControl[]

  @@unique([deviceId, cardIndex])
  @@map("audio_card")
}

model mixerControl {
  id Int @id @default(autoincrement())
  audioCardId Int
  audioCard audioCard @relation(fields: [audioCardId], references: [id], onDelete: Cascade)

  name String
  volume String @default("off")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([audioCardId, name])
  @@map("mixer_control")
}

model audio {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  name      String   @map("original_name")
  extension String
  path      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  audioFormat audioFormat?
  audioCommon audioCommon?

  @@map("audio")
}

model audioFormat {
  id Int @id @default(autoincrement())
  audioId Int @unique @map("audio_id")
  container String?
  codec String?
  sampleRate Int? @map("sample_rate")
  numberOfChannels Int? @map("number_of_channels")
  bitrate Int?
  duration Float?

  audio audio @relation(fields: [audioId], references: [id], onDelete: Cascade)
  @@map("audio_format")
}

model audioCommon {
  id Int @id @default(autoincrement())
  audioId Int @unique @map("audio_id")
  title String?
  artist String?
  album String?
  year Int?
  picturePath String?

  audio audio @relation(fields: [audioId], references: [id], onDelete: Cascade)
  @@map("audio_common")
}
